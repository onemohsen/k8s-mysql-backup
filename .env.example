# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — keep real namespaces/pods/buckets out of git.

# --- build ---
KUBECTL_VERSION=v1.31.0
TARGETARCH=amd64                 # arm64 if uname -m is aarch64

# --- schedule ---
CRON_SCHEDULE=0 2 * * *          # daily 02:00
TZ=Asia/Tehran

# --- what to back up ---
# One entry per DB pod, space-separated on a single line. Format:
#   namespace/selector                    -> user=root, pass=$PASSWORD_VAR
#   namespace/selector/USER_VAR/PASS_VAR  -> user=$USER_VAR, pass=$PASS_VAR
# "selector" is a label selector resolved to the running pod at runtime
# (survives redeploys). USER_VAR/PASS_VAR are env vars that exist INSIDE the pod.
#   labels:   kubectl get pod -n <ns> --show-labels
#   env vars: kubectl exec -n <ns> <pod> -- env | grep -i mysql
TARGETS=app-one/app=mysql/MYSQL_USER/MYSQL_PASSWORD app-two/app=mysql/MYSQL_USER/MYSQL_PASSWORD

# Fallback in-pod password var for entries without USER_VAR/PASS_VAR (root):
PASSWORD_VAR=MYSQL_ROOT_PASSWORD

# Every non-system database is dumped to its OWN file. information_schema,
# performance_schema, sys and mysql are always skipped; add extras here:
# EXCLUDE_DBS=some_scratch_db another_db
# EXTRA_DUMP_FLAGS=--hex-blob   # appended to mysqldump if you need more

# --- where it goes ---
RCLONE_REMOTE=s3
RCLONE_PATH=my-bucket/mysql-backups
RETENTION_DAYS=7
