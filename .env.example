# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — keep real namespaces/pods/buckets/passwords out of git.

# --- build ---
KUBECTL_VERSION=v1.31.0
TARGETARCH=amd64                 # arm64 if uname -m is aarch64

# --- schedule ---
CRON_SCHEDULE=0 2 * * *          # daily 02:00
TZ=Asia/Tehran

# --- what to back up ---
# One entry per DB pod, space-separated on a single line. Format:
#   namespace/pod/user/password    (the password may itself contain '/')
# Find pod names with: kubectl get pod -n <namespace>
#
# MUST be wrapped in double quotes: passwords often contain '#', which the
# docker-compose .env parser would otherwise treat as a comment and truncate.
TARGETS="app-one/app-one-mysql-0/backup_user/p4ssw0rd app-two/app-two-mysql-0/backup_user/an0ther#pass"

# Each non-system database -> its own file. information_schema, performance_schema,
# sys and mysql are always skipped; add extras here:
# EXCLUDE_DBS=some_scratch_db another_db
# Skip specific TABLES (applied to every dumped DB). For Laravel apps, Telescope
# tables are disposable debug data that bloat dumps massively — drop them:
# EXCLUDE_TABLES=telescope_entries telescope_entries_tags telescope_monitoring
# Override the full mysqldump flag set (e.g. drop --events for a restricted user):
# DUMP_FLAGS=--single-transaction --quick --no-tablespaces
# Appended to mysqldump:
# EXTRA_DUMP_FLAGS=--hex-blob
# Retry a transient/truncated dump before failing it (each DB is verified for the
# mysqldump "-- Dump completed" footer; a partial dump is retried, then failed):
DUMP_RETRIES=3
DUMP_BACKOFF=15                  # base seconds between retries (linear backoff)

# --- where it goes ---
RCLONE_REMOTE=s3
RCLONE_PATH=my-bucket/mysql-backups
RETENTION_DAYS=7
